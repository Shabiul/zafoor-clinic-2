# Postgres connection. The public website (../website) MUST point at this
# same database — that's how a website booking shows up in the CRM instantly,
# with no sync job. See ../website/.env.example.
#
# DATABASE_URL = Supabase's dedicated pooler host (Supabase dashboard ->
# Project Settings -> Database -> Connection pooling -> "Transaction" mode).
# MUST be the dedicated "aws-0-<region>.pooler.supabase.com:6543" host, not
# same-host-different-port - Supabase's direct db.<ref>.supabase.co host is
# IPv6-only on most projects, which Vercel's serverless runtime cannot reach
# at all (fails with Prisma error P1001 "Can't reach database server").
# The pooler host is the IPv4-reachable one; that's the whole reason it
# exists. Append ?pgbouncer=true - pgbouncer's transaction mode doesn't
# support prepared statements, and this flag tells Prisma to skip them.
#
# DIRECT_URL = Supabase's direct connection (port 5432, db.<ref>.supabase.co).
# Only used locally for `prisma migrate`/`prisma db push` (pgbouncer can't
# run schema changes) - never used by the deployed app itself, so it being
# IPv6-only doesn't matter here. Local dev without Supabase can point both
# at the same local DB.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Project Configuration
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

# Optional notification keys
EMAIL_API_KEY=""
SMS_API_KEY=""

# Vercel Blob (for uploading patient documents, clinic assets, and clinical attachments)
BLOB_READ_WRITE_TOKEN=""

# Public site origins allowed to call the booking API (comma-separated, e.g. https://zafoor-clinic-2-nxbz.vercel.app or custom domains)
PUBLIC_SITE_ORIGIN=""
